// Native acrylic base inspired by LuminarLeaf, with a subtle Catppuccin border.
theme
{
	name="modern"
	view=view.medium
	dark=auto

	background
	{
		color=auto
		opacity=0
		effect=[3, auto, 10]
	}

	item
	{
		prefix=1
		radius=2
	}

	border
	{
		enabled=true
		size=1
		color=color.accent
		opacity=35
		radius=2
	}

	shadow
	{
		enabled=true
		size=5
		color=#11111b
		opacity=5
	}

	separator
	{
		size=1
		opacity=25
		margin.left=10
		margin.right=10
	}

	image
	{
		enabled=true
		align=2
		color=[auto, color.accent, auto]
	}
}
