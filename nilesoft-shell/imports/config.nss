// Portable application paths. Edit only this file when apps use custom locations.
$code_exe='@user.localappdata\Programs\Microsoft VS Code\Code.exe'
$neovide_exe='@sys.prog\Neovide\neovide.exe'
$everything_exe='@sys.prog\Everything\Everything.exe'
$peazip_exe='@sys.prog\PeaZip\PEAZIP.EXE'

// File-type groups shared by menu modules.
$archive_pattern='.zip|.7z|.rar|.tar|.gz|.tgz|.bz2|.tbz2|.xz|.txz|.zst|.tzst|.cab|.iso|.wim|.zipx|.001|.pea'
$code_ext=[
	".txt", ".md", ".markdown", ".nss", ".json", ".jsonc", ".xml", ".yaml",
	".yml", ".toml", ".ini", ".cfg", ".conf", ".log", ".csv", ".html",
	".htm", ".css", ".scss", ".less", ".js", ".jsx", ".mjs", ".cjs",
	".ts", ".tsx", ".vue", ".py", ".pyi", ".java", ".c", ".cc", ".cpp",
	".h", ".hpp", ".cs", ".go", ".rs", ".php", ".rb", ".lua", ".sql",
	".sh", ".bash", ".zsh", ".ps1", ".psm1", ".bat", ".cmd", ".dockerfile"
]
$executable_ext=[".exe", ".com", ".scr", ".cpl"]
$printable_ext=[
	".doc", ".docx", ".pdf", ".xls", ".xlsx", ".ppt", ".pptx",
	".jpg", ".jpeg", ".png", ".bmp", ".gif", ".tif", ".tiff"
]
